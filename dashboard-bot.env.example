# Copy to <secrets folder>/dashboard-bot.env (default ~/.desk-dashboard/dashboard-bot.env, or set DASHBOARD_SECRETS_DIR).
# Never commit the real file: *.env is gitignored.

# From @BotFather
DASHBOARD_BOT_TOKEN=
# Your numeric Telegram user id: the bot answers this id in a private chat and nobody else
DASHBOARD_OWNER_ID=

# Optional
# DASHBOARD_AGENT_MODEL=claude-haiku-5-5
# DASHBOARD_AGENT_CAP_USD=10
# DASHBOARD_AGENT_WARN_USD=8
# DASHBOARD_AGENT_ENABLED=0
# DASHBOARD_RELAY_URL=https://ntfy.sh
# DASHBOARD_RELAY=0
# HUB_PORT=8797
